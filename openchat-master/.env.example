# Database
DATABASE_URL=postgresql://openchat:openchat@localhost:5432/openchat

# Redis
REDIS_URL=redis://localhost:6379

# File storage
# STORAGE_DRIVER=local  -> save uploads to disk (default; no MinIO/Docker needed)
# STORAGE_DRIVER=s3     -> use the S3-compatible settings below (MinIO in dev)
STORAGE_DRIVER=local
# LOCAL_STORAGE_DIR=.data/storage   # where local files live (relative to cwd)

# MinIO / S3 (only used when STORAGE_DRIVER=s3)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=openchat
S3_SECRET_KEY=openchat123
S3_BUCKET=openchat
S3_REGION=us-east-1

# Server
PORT=3001

# Model provider keys (add as needed)
# OPENAI_API_KEY=            # Only needed if using OpenAI models / embeddings
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=
# DEEPSEEK_API_KEY=
# MIMO_API_KEY=
OPENROUTER_API_KEY=          # Paste your OpenRouter API key here (server-side only)
# OPENROUTER_SITE_URL=https://your-site.example  # Optional: attribution for OpenRouter rankings
OPENROUTER_FREE_ONLY=true    # Default true: list only $0 models. Set false to include paid.
# Default chat model: nvidia/nemotron-3.5-lightning:free

# Tool configuration
SERPER_API_KEY=              # For web_search tool (serper.dev)
CODE_EXECUTION_ENABLED=true  # Set to false to disable code execution
DOCKER_SOCKET=/var/run/docker.sock  # Docker socket for sandbox

# Embeddings (for project knowledge / RAG / memory)
EMBEDDING_MODEL=text-embedding-3-small  # OpenAI embedding model for doc chunks and memory
