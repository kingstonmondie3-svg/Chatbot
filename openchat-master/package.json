{
  "name": "openchat",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --parallel --filter @openchat/providers --filter @openchat/server --filter @openchat/web run dev",
    "build": "tsc -b && pnpm --filter @openchat/web run build:vite",
    "typecheck": "tsc -b",
    "test": "pnpm -r run test",
    "lint": "eslint .",
    "db:push": "pnpm drizzle-kit push",
    "db:studio": "pnpm drizzle-kit studio"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "drizzle-kit": "^0.30.0",
    "drizzle-orm": "^0.38.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-react": "^7.37.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "globals": "^16.0.0",
    "prettier": "^3.4.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.0.0"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.20.0"
}
